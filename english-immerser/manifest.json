{
  "manifest_version": 3,
  "name": "英语沉浸 - English Immerser",
  "version": "1.0",
  "description": "将网页中的中文短语智能替换为英文，在浏览中自然提升英语水平。Powered by DeepSeek.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "英语沉浸"
  }
}
